// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model organizations{
  id Int @id @default(autoincrement())
  name String
  code String @unique
  is_active Boolean

  owner_user_id Int @unique
}

model branches{
  id Int @id @default(autoincrement())
  name String
  city String
  address String
  is_active Boolean
}

model roles{
  id Int @id @default(autoincrement())
  name String @unique

  user user_roles[]
}

model user_roles {
  id Int @id @default(autoincrement())
  
  user_id Int
  role_id Int

  user users @relation(fields: [user_id], references: [id])
  role roles @relation(fields: [role_id], references: [id])
}

model users{
  id Int @id @default(autoincrement())
  username String @unique
  password String
  is_active Boolean

  roles user_roles[]
}